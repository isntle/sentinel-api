# ════════════════════════════════════════════════════════════════════════════════
# SENTINEL API — Plantilla de Configuración de Entorno (.env.example)
# NOTA: Ningún valor sensible/secreto real debe guardarse en este archivo.
# Copiar este archivo a .env en el entorno local o configurar variables en el host.
# ════════════════════════════════════════════════════════════════════════════════

# ── Base de Datos y Almacenamiento ──
# Base de datos relacional (SQLite para piloto local/staging, PostgreSQL para cluster)
DATABASE_URL=sqlite:///./sentinel.db

# ── Kill Switches y Modos Operativos ──
# Habilita o desactiva la ejecución pasiva en modo sombra (S16)
SENTINEL_SHADOW_ENABLED=true
# Desactiva llamadas a LLM externos en caso de caída o costo (forzando fallback fail-closed local)
SENTINEL_DISABLE_LLM=false

# ── Proveedores de Modelos de Lenguaje (Opcionales para Modo Escalación) ──
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Integraciones de Scraping de Jerga (Admin / Hot Terms) ──
YOUTUBE_API_KEY=
GENIUS_API_TOKEN=

# ── Criptografía, Privacidad y Salteado de Red ──
# Sal requerida para hashear identificadores de actor y prevenir correlación cross-tenant
ACTOR_HASH_SALT=sentinel-pilot-salt-replace-with-secure-random-bytes

# Firma de tokens efímeros para telemetría sendBeacon
TELEMETRY_TOKEN_SECRET=sentinel-pilot-telemetry-secret-replace-with-secure-random-bytes

# ── Criptografía Ed25519 de Artefactos de Modelo/Packs ──
# Clave privada Ed25519 en Base64URL (32 bytes) para firma de artefactos en servidor
ARTIFACT_SIGNING_PRIVATE_KEY=
ARTIFACT_SIGNING_KEY_ID=sentinel-pilot-v1
ARTIFACT_TTL_SECONDS=86400

# ── Seguridad y Acceso Web (CORS) ──
# Orígenes web autorizados separados por coma (ej. https://pilot.client.org)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# ── Límites Operativos y Retención ──
# Ventana de retención máxima para mensajes crudos antes de purga automática (en días)
MESSAGE_RETENTION_DAYS=30
# Retención de paquetes de evidencia bajo Legal Hold (en días)
LEGAL_HOLD_RETENTION_DAYS=365
